    label.BackgroundTransparency = 1; label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 180, 255); label.TextSize = 14
    label.Font = Enum.Font.GothamMedium; label.TextXAlignment = Enum.TextXAlignment.Left
    table.insert(NotificationsQueue, notif)
    TweenService:Create(notif, TweenInfo.new(0.3), {BackgroundTransparency = 0.3}):Play()
    task.delay(duration, function()
        if notif and notif.Parent then
            TweenService:Create(notif, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
            for _, v in ipairs(notif:GetDescendants()) do
                if v:IsA("TextLabel") then TweenService:Create(v, TweenInfo.new(0.3), {TextTransparency = 1}):Play() end
            end
            task.wait(0.3); notif:Destroy()
            for i, n in ipairs(NotificationsQueue) do if n == notif then table.remove(NotificationsQueue, i); break end end
        end
    end)
end

