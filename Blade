local function notify(title, msg, duration)
    if not (cfg.ui.notifications and notifyHolder) then return end
    duration = duration or 3
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 52)
    card.BackgroundColor3 = C(T.panel)
    card.BackgroundTransparency = 0.05
    card.BorderSizePixel = 0
    card.Parent = notifyHolder
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 8); corner.Parent = card
    local stroke = Instance.new("UIStroke"); stroke.Color = C(T.accent); stroke.Transparency = 0.4; stroke.Parent = card
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, 0); bar.BackgroundColor3 = C(T.accent); bar.BorderSizePixel = 0; bar.Parent = card
    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1; tl.Size = UDim2.new(1, -14, 0, 20)
    tl.Position = UDim2.new(0, 10, 0, 6); tl.Font = Enum.Font.GothamBold; tl.TextSize = 13
    tl.TextXAlignment = Enum.TextXAlignment.Left; tl.TextColor3 = C(T.text); tl.Text = title; tl.Parent = card
    local ml = Instance.new("TextLabel")
    ml.BackgroundTransparency = 1; ml.Size = UDim2.new(1, -14, 0, 18)
    ml.Position = UDim2.new(0, 10, 0, 26); ml.Font = Enum.Font.Gotham; ml.TextSize = 11
    ml.TextXAlignment = Enum.TextXAlignment.Left; ml.TextColor3 = C(T.sub); ml.Text = msg; ml.Parent = card

    card.BackgroundTransparency = 1; bar.BackgroundTransparency = 1; tl.TextTransparency = 1; ml.TextTransparency = 1
    TweenService:Create(card, TweenInfo.new(cfg.ui.animSpeed), {BackgroundTransparency = 0.05}):Play()
    TweenService:Create(bar, TweenInfo.new(cfg.ui.animSpeed), {BackgroundTransparency = 0}):Play()
    TweenService:Create(tl, TweenInfo.new(cfg.ui.animSpeed), {TextTransparency = 0}):Play()
    TweenService:Create(ml, TweenInfo.new(cfg.ui.animSpeed), {TextTransparency = 0}):Play()

    task.delay(duration, function()
        local out = TweenInfo.new(cfg.ui.animSpeed)
        TweenService:Create(card, out, {BackgroundTransparency = 1}):Play()
        TweenService:Create(bar, out, {BackgroundTransparency = 1}):Play()
        TweenService:Create(tl, out, {TextTransparency = 1}):Play()
        TweenService:Create(ml, out, {TextTransparency = 1}):Play()
        task.wait(cfg.ui.animSpeed)
        card:Destroy()
    end)
end

