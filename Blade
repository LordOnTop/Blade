local BallsFolder = nil
local ParryRemote = nil

local function DiscoverBallsFolder()
    local folder = Workspace:FindFirstChild("Balls")
    if folder and folder:IsA("Folder") then BallsFolder = folder; return true end
    return false
end

local function DiscoverParryRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("RemoteEvents")
    if not remotes then return false end
    for _, name in ipairs({"ParryButtonPress","ParryAttempt","Parry","AttemptParry","Block"}) do
        local r = remotes:FindFirstChild(name)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then ParryRemote = r; return true end
    end
    for _, obj in ipairs(remotes:GetChildren()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and obj.Name:lower():find("parry") then ParryRemote = obj; return true end
    end
    return false
end

local function IsRealBall(ball)
    if typeof(ball) ~= "Instance" or not ball:IsA("BasePart") then return false end
    if not BallsFolder or not ball:IsDescendantOf(BallsFolder) then return false end
    local real = ball:GetAttribute("realBall")
    if real ~= nil then return real == true end
    return ball.AssemblyLinearVelocity.Magnitude > 0
end

local function GetTargetBall()
    if not BallsFolder then return nil end
    for _, ball in ipairs(BallsFolder:GetChildren()) do
        if IsRealBall(ball) then
            local target = ball:GetAttribute("target")
            local targeting = ball:GetAttribute("IsTargeting")
            if target == LocalPlayer.Name or targeting == LocalPlayer.Name or targeting == true then return ball end
        end
    end
    local closest, minDist = nil, math.huge
    local root = GetRoot(); if not root then return nil end
    for _, ball in ipairs(BallsFolder:GetChildren()) do
        if IsRealBall(ball) then
            local d = (ball.Position - root.Position).Magnitude
            if d < minDist then minDist = d; closest = ball end
        end
    end
    return closest
end

local function FireParry()
    local now = tick()
    if now - LastParry < Config.ReactionTime then return end
    if Config.ParryMethod == "Remote" and ParryRemote then
        pcall(function()
            if ParryRemote:IsA("RemoteEvent") then ParryRemote:FireServer() else ParryRemote:InvokeServer() end
        end)
        LastParry = now; return
    end
    if VirtualInputManager then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
    end
    LastParry = now
end

local function SmartParryTick()
    if not (Config.AutoParry or Config.PerfectParry or Config.SmartParry) then return end
    if not BallsFolder then return end
    local ball = GetTargetBall(); if not ball then return end
    local root = GetRoot(); if not root then return end
    local ballPos, ballVel = ball.Position, ball.AssemblyLinearVelocity
    local charPos, charVel = root.Position, root.AssemblyLinearVelocity
    local distance = (ballPos - charPos).Magnitude
    if distance > Config.ParryDistance * 2 then return end
    local dirToPlayer = (charPos - ballPos).Unit
    local approachSpeed = ballVel:Dot(dirToPlayer) - charVel:Dot(dirToPlayer)
    if approachSpeed <= 0 then return end
    local timeToImpact = distance / approachSpeed
    local threshold = Config.ReactionTime
    if Config.SmartParry then threshold = math.max(0.08, Config.ReactionTime - (ballVel.Magnitude * 0.0005)) end
    if Config.PerfectParry then threshold = threshold * 0.6 end
    if timeToImpact <= threshold and distance <= Config.ParryDistance then FireParry() end
    if Config.AutoSpamParry and timeToImpact <= Config.ReactionTime * 2 and distance <= Config.ParryDistance * 1.5 then FireParry() end
end

local function ClearBallHighlight()
    if BallHighlight and BallHighlight.Parent then BallHighlight:Destroy() end
    BallHighlight = nil
end

local function UpdateBallHighlight()
    if not Config.BallHighlight then ClearBallHighlight(); return end
    local ball = GetTargetBall(); if not ball then ClearBallHighlight(); return end
    if not BallHighlight or BallHighlight.Parent ~= ball then
        ClearBallHighlight()
        BallHighlight = Instance.new("Highlight")
        BallHighlight.Name = "BBH_BallHighlight"
        BallHighlight.FillColor = Config.ThemeColor; BallHighlight.FillTransparency = 0.5
        BallHighlight.OutlineColor = Color3.fromRGB(255, 100, 255); BallHighlight.OutlineTransparency = 0
        BallHighlight.Parent = ball
    end
end

local function DrawTrajectory()
    for i = #Drawings, 1, -1 do
        local d = Drawings[i]
        if typeof(d) ~= "Instance" then pcall(function() d:Remove() end); table.remove(Drawings, i) end
    end
    if not Config.Trajectory or not Drawing then return end
    local ball = GetTargetBall(); if not ball then return end
    local pos, vel = ball.Position, ball.AssemblyLinearVelocity
    local points = {}
    for t = 0, 1.5, 0.05 do table.insert(points, pos + vel * t) end
    for i = 1, #points - 1 do
        local a = Camera:WorldToViewportPoint(points[i]); local b = Camera:WorldToViewportPoint(points[i + 1])
        if a.Z > 0 and b.Z > 0 then
            local line = Drawing.new("Line")
            line.Visible = true; line.Color = Config.ThemeColor; line.Thickness = 2; line.Transparency = 0.8
            line.From = Vector2.new(a.X, a.Y); line.To = Vector2.new(b.X, b.Y)
            table.insert(Drawings, line)
        end
    end
end

local function ApplyPlayerESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char then
                if Config.PlayerESP and Config.PlayerHighlight then
                    if not PlayerHighlights[plr] or not PlayerHighlights[plr].Parent then
                        local hl = Instance.new("Highlight")
                        hl.Name = "BBH_PlayerHighlight"; hl.FillColor = Config.ThemeColor; hl.FillTransparency = 0.6
                        hl.OutlineColor = Color3.fromRGB(200, 120, 255); hl.OutlineTransparency = 0.2
                        hl.Parent = char; PlayerHighlights[plr] = hl
                    end
                else
                    if PlayerHighlights[plr] then PlayerHighlights[plr]:Destroy(); PlayerHighlights[plr] = nil end
                end
            end
        end
    end
end

