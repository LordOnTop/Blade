local function Notify(text, duration)
    if not Config.Notifications or not UIRoot then return end
    duration = duration or 3
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 280, 0, 40)
    notif.Position = UDim2.new(1, -300, 0, 20 + (#NotificationsQueue * 50))
    notif.BackgroundColor3 = Color3.fromRGB(20, 10, 30)
    notif.BorderSizePixel = 0
    notif.BackgroundTransparency = 0.05
    notif.Parent = UIRoot
    local corner = Instance.new("UICorner", notif); corner.CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", notif); stroke.Color = Config.ThemeColor; stroke.Thickness = 1
    local label = Instance.new("TextLabel", notif)
