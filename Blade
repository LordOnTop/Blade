        Position = UDim2.new(0, 5, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.SubText,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    })
    Create("TextLabel", {
        Parent = Row,
        Size = UDim2.new(0.5, -10, 1, 0),
        Position = UDim2.new(0.5, 5, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right
    })
end

-- List Row Component (For Databases)
local function CreateListRow(parent, columns)
    local Row = Create("Frame", {
        Parent = parent,
        Size = UDim2.new(1, -20, 0, 30),
        BackgroundTransparency = 0.5,
        BackgroundColor3 = Theme.Main,
    })
    Create("UICorner", { Parent = Row, CornerRadius = UDim.new(0, 4) })
    
    local spacing = 1 / #columns
    for i, colData in ipairs(columns) do
        Create("TextLabel", {
            Parent = Row,
            Size = UDim2.new(spacing, -10, 1, 0),
            Position = UDim2.new((i-1) * spacing, 5, 0, 0),
            BackgroundTransparency = 1,
            Text = tostring(colData),
            TextColor3 = i == 1 and Theme.Accent or Theme.Text,
            TextSize = 12,
            Font = i == 1 and Enum.Font.GothamBold or Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left
        })
    end
end

