    l.Font = Enum.Font.Gotham; l.TextSize = 12; l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextColor3 = C(T.text); l.Text = name; l.Parent = row
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 30, 0, 16); btn.Position = UDim2.new(1, -40, 0.5, -8)
    btn.BackgroundColor3 = C(T.bg); btn.BorderSizePixel = 0; btn.Text = ""; btn.Parent = row
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1, 0); bc.Parent = btn
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12); knob.Position = UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = C(T.sub); knob.BorderSizePixel = 0; knob.Parent = btn
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob
    local state = default and true or false
    local function apply()
        TweenService:Create(btn, TweenInfo.new(cfg.ui.animSpeed), {BackgroundColor3 = state and C(T.accent) or C(T.bg)}):Play()
        TweenService:Create(knob, TweenInfo.new(cfg.ui.animSpeed), {
            Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
            BackgroundColor3 = state and C(T.text) or C(T.sub),
        }):Play()
        local ok, err = pcall(cb, state)
        if not ok then notify("Erro", tostring(err), 4) end
    end
    btn.MouseButton1Click:Connect(function() state = not state; apply() end)
    if state then task.defer(apply) end
    registerItem(row, cat, name)
    return row
end

local function makeSlider(parent, cat, name, min, max, default, cb)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 40); row.BackgroundColor3 = C(T.panel); row.BackgroundTransparency = 0.55
    row.BorderSizePixel = 0; row.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 5); c.Parent = row
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1; l.Size = UDim2.new(1, -60, 0, 18); l.Position = UDim2.new(0, 10, 0, 3)
    l.Font = Enum.Font.Gotham; l.TextSize = 12; l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextColor3 = C(T.text); l.Text = name; l.Parent = row
    local val = Instance.new("TextLabel")
    val.BackgroundTransparency = 1; val.Size = UDim2.new(0, 50, 0, 18); val.Position = UDim2.new(1, -58, 0, 3)
    val.Font = Enum.Font.GothamBold; val.TextSize = 12; val.TextColor3 = C(T.accent)
    val.TextXAlignment = Enum.TextXAlignment.Right; val.Text = tostring(default); val.Parent = row
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, 6); track.Position = UDim2.new(0, 10, 0, 26)
    track.BackgroundColor3 = C(T.bg); track.BorderSizePixel = 0; track.Parent = row
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1, 0); tc.Parent = track
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = C(T.accent); fill.BorderSizePixel = 0; fill.Parent = track
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1, 0); fc.Parent = fill

    local value = default
    local function setValue(v, fire)
        value = math.clamp(v, min, max)
        val.Text = (value % 1 == 0) and tostring(round(value)) or string.format("%.2f", value)
        local alpha = (value - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        if fire then local ok, err = pcall(cb, value); if not ok then notify("Erro", tostring(err), 4) end end
    end
    setValue(default, false)

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            setValue(min + (max - min) * rel, true)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    registerItem(row, cat, name)
    return row
end

