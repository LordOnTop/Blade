-- 2. Leveling Center
Pages.Leveling = function()
    ClearContent()
    local card = CreateCard("LEVEL PROGRESS & RECOMMENDATIONS", UDim2.new(1, -10, 0, 120))
    
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    local level = stats and stats:FindFirstChild("Level") and stats.Level.Value or 1
    
    local recIsland = "Starter Island"
    for _, island in ipairs(Data.Islands.FirstSea) do
